    subgraph BackendGateway["⚡ FASTAPI ASYNC BACKEND & CORE SERVICES"]
        direction TB
        API["🌐 FastAPI Gateway (/api/v1)"]

        subgraph CoreServices["Domain Engines & Microservices"]
            CVService["👁️ Computer Vision Service<br/>• U²-Net Salient Segmentation<br/>• OpenCV CLAHE LAB Equalization<br/>• Visual Complexity Scoring"]
            NLPService["🧠 Multilingual NLP Service<br/>• Whisper Regional Dialect ASR<br/>• IndicTrans2 Multi-Language MT<br/>• Fine-Tuned Mistral-7B LLM"]
