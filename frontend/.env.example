[TEMPLATE]
# FastAPI backend base URL used by the browser API client (lib/catalogApi.ts).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Production database (PostgreSQL / Supabase). Unset falls back to the local
# development JSON file in data/, which is migrated automatically on first run.
DATABASE_URL=

# ONDC Beckn gateway base URL (server-only). Local default targets the
# beckn-sandbox sidecar in docker-compose.yml (beckn_sandbox, host port 3100);
# no separate Beckn Gateway runs locally by default — see docs/deployment-guide.md.
# Staging switch: ONDC_GATEWAY_URL=https://staging.gateway.ondc.org
ONDC_GATEWAY_URL=http://localhost:3100

# ONDC buyer redirect and seller listing adapters. Server-only (never expose to
# the browser bundle): read under frontend/app/api/** and frontend/backend/**.
ONDC_CHECKOUT_URL=
ONDC_SELLER_LISTING_URL=
ONDC_SELLER_TOKEN=
ONDC_WEBHOOK_SECRET=

# GeM seller API seam — RESERVED for a future GeM-approved API (server-only,
# never NEXT_PUBLIC_): read under frontend/app/api/** and frontend/backend/**.
# Packet generation (frontend/backend/gem.ts) needs NEITHER value — GeM exposes
# no public seller catalog-upload API, so the packet is uploaded by hand
# (map #201). Unset => getGemEnv() reports configured:false with a reason.
GEM_PORTAL_API_URL=
GEM_SELLER_TOKEN=

# Regional-language payment confirmation call provider
CONFIRMATION_CALL_URL=
CONFIRMATION_CALL_TOKEN=

# OTP delivery provider (server-side only; the code is never stored in plaintext)
OTP_PROVIDER_URL=
OTP_PROVIDER_TOKEN=
OTP_PROVIDER_TEMPLATE=

# Separate OpenCV/rembg/U2-Net processing worker
STUDIO_SERVICE_URL=
STUDIO_SERVICE_TOKEN=

# Bhashini translation API. Keep these server-only; do not use a model-provider key.
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_TRANSLATION_SERVICE_ID=
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_INFERENCE_API_KEY=

# LLM form-extraction providers (server-only — never expose with a NEXT_PUBLIC_ prefix)
# Clairic (Cloudflare Workers AI) is tried FIRST when both values are set.
# It is grounded typed extraction — no JSON-in-markdown parsing, no Groq/OpenRouter
# transcript disclosure. Groq/OpenRouter below remain the fallback chain.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional: 'clairic' (default, 27B) or 'clairic-flash' (faster)
CLOUDFLARE_CLAIRIC_MODEL=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional override of the pinned attempt-3 model (empty = qwen/qwen3.8-27b:free)
OPENROUTER_MODEL=
