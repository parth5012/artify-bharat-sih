# --- Core Security & Database ---
SECRET_KEY=artify_bharat_super_secret_jwt_key_2026_sih
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/artify_bharat
REDIS_URL=redis://localhost:6379/0

# --- PII Vault (AES-256-GCM Tokenization for Aadhaar / Pehchan / TRIFED IDs) ---
# Generate with: python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
PII_VAULT_KEY=

# --- Object Storage (MinIO / S3 / R2) ---
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./media_storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=artify-bharat-assets
S3_REGION=ap-south-1

# --- AI & Processing Mode ---
USE_MOCK_AI=True

# --- Ask Dadi online agent (Groq) - backend/.env is the single source of truth ---
# Get a free key: https://console.groq.com/keys  (keys start with 'gsk_')
# GROQ_API_KEY=gsk_replace_with_your_real_key
# Model MUST support custom tool calling - do NOT use groq/compound(-mini):
# supported: openai/gpt-oss-120b (default), openai/gpt-oss-20b, qwen/qwen3.6-27b
# GROQ_MODEL=openai/gpt-oss-120b

# --- LangSmith Observability (Ask Dadi agent tracing) ---
# Create a free API key at https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=artify-bharat-ask-dadi
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Optional: Groq-backed online agent mode for 'Ask Dadi'
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# --- Government e-KYC ---
MOSJE_PMDAKSH_API_URL=https://pmdaksh.dosje.gov.in/api/v1/verify
ESHRAM_LOOKUP_API_URL=https://eshram.gov.in/api/v1/lookup
TRIFED_VERIFY_API_URL=https://trifed.tribal.gov.in/api/verify
PMSURAJ_LOOKUP_API_URL=https://pmsuraj.gov.in/api/v1/lookup

# --- Logistics & DBT ---
