            PassportCrypto["🔒 Passport Crypto Engine<br/>• Deterministic SHA-256 Hash<br/>• High-Contrast QR Code Generator"]
            ExportService["🔄 Channel Export Adapters<br/>• JSON-to-XML/CSV Engines<br/>• Beckn Protocol Serializers"]
        end

        API --> CoreServices
    end

    subgraph AsyncInfrastructure["⚙️ ASYNCHRONOUS PIPELINE & TASK QUEUE"]
        CeleryWorker["⚡ Celery Distributed Workers"]
        RedisBroker[("🔴 Redis In-Memory Broker & Cache")]
        ScraperCron["🕷️ Daily Market Price Scraper<br/>(GeM, Amazon Karigar, ONDC)"]

        RedisBroker <--> CeleryWorker
        ScraperCron --> RedisBroker
        CeleryWorker --> PricingService
        CeleryWorker --> CVService
        CeleryWorker --> NLPService
    end

    subgraph StorageLayer["🗄️ PERSISTENCE & OBJECT STORAGE"]
        PostgresDB[("🐘 PostgreSQL / SQLite<br/>• Artisan Profiles & TRIFED IDs<br/>• Product Catalogs & GI Tags<br/>• Cryptographic SHA-256 Hashes<br/>• Statutory Pricing Logs")]
        ObjectStorage[("☁️ AWS S3 / MinIO Storage<br/>• Raw Photos & 1:1 Studio PNGs<br/>• Dialect Voice Story Audio<br/>• Generated QR Code Assets")]
    end

    subgraph TargetChannels["🌐 MULTI-CHANNEL GOVERNMENT & ENTERPRISE EXPORTS"]
        direction TB
        GeM["🏛️ GeM (Govt e-Marketplace)<br/>XML / CSV with HSN & TRIFED ID"]
        ONDC["🛍️ ONDC Network<br/>Beckn Protocol JSON Specifications"]
        Karigar["🛒 Amazon Karigar / Commercial<br/>B2C E-Commerce Listings"]
        B2B["🏢 Direct B2B Institutional<br/>Bulk Procurement Tiered Pricing"]
    end

    subgraph BuyerVerification["🔍 PART B: BUYER TRUST & PROVENANCE VERIFICATION"]
        direction TB
        ScanQR["📷 Scan Passport QR Code<br/>(Printed Tag / Digital Listing)"]
        WebPortal["🏛️ Public Heritage Passport Portal<br/>(http://localhost:8000/verify/{hash})"]
        
        subgraph TrustFeatures["Verified Trust Badges"]
            ArtisanBio["👤 Verified Artisan Profile<br/>TRIFED ID & Pehchan ID & GI Status"]
            VoiceClip["🎙️ Original Voice Story Stream<br/>(Artisan Native Dialect Audio)"]
            CostBreakdown["⚖️ 0% Middleman Cost Transparency<br/>• Raw Materials: ₹500<br/>• Fair Wage (15 Days): ₹2,250<br/>• Artisan Direct Profit: ₹1,750"]
        end

        ScanQR --> WebPortal
        WebPortal --> TrustFeatures
    end

    %% Wiring Connections
    SellerFlow ==>|REST API / Multipart| API
    RoomDB -.->|Auto Retry on 4G/WiFi| API
    API <--> PostgresDB
