# ==============================================================================
# Artify Bharat Monorepo - Master .gitignore
# ==============================================================================

# --- Python / FastAPI / uv / Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Database & Storage ---
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
artify_bharat.db
media_storage/
uploads/
storage/

# --- Testing & Code Coverage ---
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.tox/
.nox/

# --- Node.js / Next.js / Frontend / Web-Portal ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Next.js build output
.next/
out/

# Vite / Vanilla build output
web-portal/dist/
frontend/dist/
dist/
.turbo/
.cache/

# --- Environment & Secret Files (Keep .env.example) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# --- ML Weights / Large Datasets ---
models/*.pth
models/*.pt
models/*.bin
models/*.onnx
models/*.safetensors
!models/.gitkeep

# --- Android / Gradle / Kotlin / Mobile ---
android/.gradle/
android/build/
android/*/build/
android/local.properties
android/*.iml
android/*/*.iml
android/.idea/
android/captures/
android/.externalNativeBuild/
android/.cxx/
*.apk
*.aab

# --- Celery / Redis / Background Tasks ---
celerybeat-schedule*
dump.rdb

# --- IDEs, Editors & Operating Systems ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Temporary Scratch Artifacts ---
*.tsbuildinfo
extracted_playbook.txt
tmp/
scratch/
*.log

.tmp
.ruff_cache/
