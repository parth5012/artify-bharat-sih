{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./frontend/*"]
    }
  },
  "include": [
    "*.d.ts",
    "frontend/**/*.ts",
    "frontend/**/*.tsx",
    "frontend/**/*.d.ts",
    "web-portal/**/*.ts",
    "web-portal/**/*.tsx",
    "web-portal/**/*.js"
  ],
  "exclude": ["node_modules", "backend"]
}
